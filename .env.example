MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=unsponsor
MYSQL_USER=unsponsor
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# YouTube Data API v3 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=

# OpenAI API (LLM 요약 + 임베딩)
OPENAI_API_KEY=

# Processing queue retry policy (initial attempt included in MAX_ATTEMPTS)
QUEUE_MAX_ATTEMPTS=3
QUEUE_RETRY_BACKOFF_BASE_SECONDS=300
QUEUE_STALE_AFTER_SECONDS=1800

# DataImpulse Residential Proxy (library 경로와 제한된 canary 전용)
# Proxy Access 상단의 기본 Login을 사용하고 __cr.* 파라미터가 붙은 Proxy List 값은 넣지 않는다.
DATAIMPULSE_PROXY_USERNAME=
DATAIMPULSE_PROXY_PASSWORD=
DATAIMPULSE_PROXY_COUNTRY=kr
